<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PoseidonGUI.HydraTerminalWindow"
        Width="1000"
        Height="650"
        MinWidth="700"
        MinHeight="450"
        Title="POSEIDON // HYDRA TERMINAL"
        Background="#000000">

    <Window.Styles>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="FontFamily" Value="monospace"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#000808"/>
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="BorderBrush" Value="#00FFFF"/>
            <Setter Property="FontFamily" Value="monospace"/>
            <Setter Property="CaretBrush" Value="#00FFFF"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#001A1A"/>
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="BorderBrush" Value="#00FFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="monospace"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#003333"/>
        </Style>

    </Window.Styles>

    <Grid Background="#000000"
          Margin="15"
          RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->

        <Border Grid.Row="0"
                BorderBrush="#00FFFF"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,10">

            <TextBlock Text="POSEIDON // HYDRA TERMINAL"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

        </Border>

        <!-- SESSION HISTORY -->

        <Border Grid.Row="1"
                BorderBrush="#00FFFF"
                BorderThickness="1"
                Padding="12">

            <ScrollViewer Name="TerminalScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">

                <TextBlock Name="TerminalOutput"
                           Text="Welcome To Hydra Poseidon. A GUI for the World's Best."
                           FontSize="14"
                           TextWrapping="NoWrap"/>

            </ScrollViewer>

        </Border>

        <!-- COMMAND INPUT -->

        <Grid Grid.Row="2"
              Margin="0,10,0,0"
              ColumnDefinitions="*,Auto">

            <TextBox Name="TerminalInput"
                     Grid.Column="0"
                     Height="42"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     PlaceholderText="Command..."/>

            <Button Name="RunButton"
                    Grid.Column="1"
                    Content="RUN"
                    Width="90"
                    Height="42"
                    Margin="10,0,0,0"/>

        </Grid>

    </Grid>

</Window>
