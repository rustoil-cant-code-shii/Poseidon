<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PoseidonGUI.BruteforceDialog"
        Width="650"
        Height="560"
        MinWidth="550"
        MinHeight="450"
        Title="POSEIDON // BRUTEFORCE">

    <Window.Styles>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="FontFamily" Value="monospace"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#000808"/>
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="BorderBrush" Value="#00FFFF"/>
            <Setter Property="FontFamily" Value="monospace"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#000808"/>
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="BorderBrush" Value="#00FFFF"/>
            <Setter Property="FontFamily" Value="monospace"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#001A1A"/>
            <Setter Property="Foreground" Value="#00FFFF"/>
            <Setter Property="BorderBrush" Value="#00FFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="monospace"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#003333"/>
        </Style>

    </Window.Styles>

    <Grid Background="#000000"
          Margin="20"
          RowDefinitions="Auto,Auto,*,Auto">

        <!-- HEADER -->

        <StackPanel Grid.Row="0"
                    Spacing="4">

            <TextBlock Text="=== POSEIDON // BRUTEFORCE ==="
                       FontSize="22"
                       FontWeight="Bold"/>

            <TextBlock Text="GRAPHICAL FRONTEND"
                       FontSize="13"/>

        </StackPanel>

        <!-- BACKEND STATUS -->

        <Border Grid.Row="1"
                Margin="0,20,0,15"
                Padding="12"
                BorderBrush="#00FFFF"
                BorderThickness="1">

            <Grid ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto">

                <TextBlock Text="BACKEND:"
                           FontWeight="Bold"
                           Margin="0,0,15,0"/>

                <TextBlock Grid.Column="1"
                           Text="HYDRA"
                           FontWeight="Bold"/>

                <TextBlock Grid.Row="1"
                           Text="STATUS:"
                           Margin="0,8,15,0"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Name="BackendStatus"
                           Text="CHECKING..."
                           Margin="0,8,0,0"/>

            </Grid>

        </Border>

        <!-- CONFIGURATION -->

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="12">

                <TextBlock Text="=== CONFIGURATION ==="
                           FontSize="16"
                           FontWeight="Bold"/>

                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto,Auto">

                    <TextBlock Text="TARGET:"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <TextBox Grid.Column="1"
                             Name="TargetInput"
                             Height="36"/>

                    <TextBlock Grid.Row="1"
                               Text="USERNAME:"
                               VerticalAlignment="Center"
                               Margin="0,10,15,0"/>

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Name="UsernameInput"
                             Height="36"
                             Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="2"
                               Text="WORDLIST:"
                               VerticalAlignment="Center"
                               Margin="0,10,15,0"/>

                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Name="WordlistInput"
                             Height="36"
                             Margin="0,10,0,0"/>

                </Grid>

                <Border BorderBrush="#00FFFF"
                        BorderThickness="1"
                        Padding="10"
                        Margin="0,5,0,0">

                    <TextBlock Text="The BRUTEFORCE module is a graphical frontend for an external security tool. Only use security testing tools against systems you own or are explicitly authorized to test."
                               TextWrapping="Wrap"
                               FontSize="12"/>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- CONTROLS -->

        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              Margin="0,15,0,0">

            <Button Name="StartButton"
                    Content="START"
                    Margin="0,0,5,0"/>

            <Button Grid.Column="1"
                    Name="StopButton"
                    Content="STOP"
                    Margin="5,0,0,0"/>

        </Grid>

    </Grid>

</Window>
